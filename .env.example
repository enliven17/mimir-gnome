# =============================================================================
# Mimir environment variables (copy to .env.local; never commit secrets)
# =============================================================================
# Everything is optional for a local build: without any chain's market contracts
# and the backend (Convex) the market pages render empty. The oracle, council and market
# creator run as Convex jobs (convex/*.ts) and read their env there.

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin for canonical and Open Graph URLs (default https://mimirmarkets.xyz)
# NEXT_PUBLIC_SITE_URL=https://mimirmarkets.xyz
# The backend (realtime index, oracle, council, creator, agents): the deployment URL from `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
# Shared secrets between the site and the backend (same value in both; 16+ characters)
# MIMIR_INTERNAL_SECRET=
# MIMIR_STORE_SECRET=
# Required with NEXT_PUBLIC_CONVEX_URL for signed Launch/follow writes: one-use authorizations live in appStore.
# Set the same store secret on web and Convex. Missing/unavailable storage returns 503; there is no memory fallback.
# MIMIR_EVENTS_SECRET=
# MIMIR_ADMIN_SECRET=
# MIMIR_LAUNCH_SECRET=
# Proxies in front of the app that append to X-Forwarded-For; the client IP is taken this many entries from the right
# TRUSTED_PROXY_HOPS=1
# The admin panel (/admin): gno.land accounts (g1…) allowed in, comma separated.
ADMIN_WALLETS=
# Google Search Console HTML-tag verification. Optional.
GOOGLE_SITE_VERIFICATION=
# PostHog (instrumentation-client.ts): analytics stay off without the key. Region us | eu.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_REGION=us

# ── gno.land (lib/gno/config.ts, lib/chains/registry.ts) ─────────────────────
# Markets run on gno.land only: the r/vs and r/pool realms stake mUSD (a GRC20, 6 dp; 1,000 a day from its faucet),
# gas is GNOT (testnet GNOT: https://faucet.gno.land). Users connect Adena. Off chain every amount is mUSD with 18
# decimals. Defaults: onyx-1 and the namespace the realms are deployed under (scripts/gno/deploy.sh).
# NEXT_PUBLIC_GNO_CHAIN_ID=onyx-1
# NEXT_PUBLIC_GNO_RPC_URL=https://rpc.onyx.testnets.gno.land:443
# NEXT_PUBLIC_GNO_NAMESPACE=g12dcsmwccgdxasqde2eumua88tlrkw83kqf6tcz
# NEXT_PUBLIC_GNOWEB_URL=https://onyx.testnets.gno.land
# NEXT_PUBLIC_GNO_FAUCET_URL=https://faucet.gno.land
# The backend's copies (Convex env, and server routes prefer them): GNO_CHAIN_ID, GNO_RPC_URL, GNO_NAMESPACE, GNOWEB_URL.
# The indexer (convex/arcSync.ts) scans block events from GNO_INDEX_FROM_BLOCK (the realms' deploy height; else the
# head at first run) and at most GNO_INDEX_MAX_BLOCKS blocks per 30 s run (default 60).
# GNO_INDEX_FROM_BLOCK=
# GNO_INDEX_MAX_BLOCKS=60
# MIMIR_BACKEND_OFF=1 turns every backend job into a no-op.

# ── Mimir's own gno.land accounts (lib/chains/house.ts; Convex env) ───────────
# BIP-39 mnemonics (gnokey's derivation). Generate them with: node --import tsx scripts/gno-wallets.ts
# Keep each funded with GNOT for gas; the creator and the council also need mUSD to stake.
# The realms' oracle: proposes, finalizes, refunds and pushes pool payouts (convex/arcOracle.ts).
# ORACLE_MNEMONIC=
# The house market creator: the public address (shown in the UI and the views) and its key (opens and stakes).
# GNO_CREATOR_ADDRESS=
# GNO_CREATOR_MNEMONIC=
# The council personas: {"<slug>": "g1…"} public addresses (also on the web server), and {"<slug>": "<mnemonic>"}.
# GNO_COUNCIL_WALLETS=
# GNO_COUNCIL_MNEMONICS=
# Extra addresses the oracle treats as Mimir's own (comma list).
# GNO_HOUSE_ADDRESSES=
# Seals the keys Mimir generates for launched agents and copy wallets (AES-256-GCM, 32+ characters). Set the SAME value
# on the web server (it makes and uses the wallets) and in Convex (the agents stake from them). Changing it strands them.
# GNO_WALLET_SECRET=

# Independent audit worker (agents/audit): run separately with only its own credentials. The owner registers its
# address with SetAuditAgent on r/vs and r/pool (node --import tsx agents/audit/run.ts --print-setup prints the calls).
# AUDIT_AGENT_MNEMONIC=
# AUDIT_AGENT_ADDRESS=
# AUDIT_GEMINI_API_KEY=
# AUDIT_ANTHROPIC_API_KEY=
# AUDIT_LLM_MODEL= # optional; must be on SETTLEMENT_MODELS allowlist
# Or an OpenAI-compatible model (e.g. DeepSeek via Token Harbor); needs AUDIT_LLM_MODEL too.
# AUDIT_OPENAI_BASE_URL=https://tokenharbor.ai/v1
# AUDIT_OPENAI_API_KEY=
# AUDIT_MODE=observe # challenge enables bonded disputes after role/balance checks
# AUDIT_STATE_FILE=./work/audit-state.json

# ── Mimir Launch (lib/launch; convex/launch*.ts) ──────────────────────────────
# Agents are free to create; each stakes from its own gno.land account (a key Mimir generates and keeps sealed under
# GNO_WALLET_SECRET), funded by its owner with mUSD and a little GNOT. Backend switches (Convex env):
# LAUNCH_AGENTS=1             agents stake on markets
# LAUNCH_AGENTS_DRY_RUN=1     decide without staking
# LAUNCH_AGENT_MARKETS=1      agents may open their own markets
# Seals an owner's own LLM key (BYOK) to its agent; 32+ characters.
# LAUNCH_BYOK_SECRET=
# Agents' own Gemini key (else the shared pool).
# LAUNCH_GEMINI_API_KEY=
# An agent's optional token is a GRC20 its owner opens from Adena through gno.land/r/demo/defi/grc20factory.
# Paid agent calls (/api/launch/<agent>/call) through the r/agentpay realm, USD per call (default 0.05)
# AGENT_API_PRICE_USD=0.05

# ── LLM (oracle, council, drafts, moderation; lib/llm.ts) ─────────────────────
# Only ONE key is needed; Gemini is preferred when both are set.
# GEMINI_API_KEY=...                       # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=sk-ant-...             # https://console.anthropic.com
# LLM_PROVIDER=gemini
# ORACLE_LLM_MODEL=gemini-3.5-flash
# The oracle's own keys: required on mainnet, never shared with web routes.
# ORACLE_GEMINI_API_KEY=
# ORACLE_ANTHROPIC_API_KEY=
# Models a settlement verdict may come from (Gemini/Claude only).
# SETTLEMENT_MODELS=gemini-3.5-flash,gemini-pro-latest,claude-sonnet-4-6
# Per-job and backup keys, fallbacks
# COUNCIL_GEMINI_API_KEY=
# CREATOR_GEMINI_API_KEY=
# GEMINI_API_KEYS=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# ANTHROPIC_MODEL=claude-sonnet-4-6
# How long a provider sits out after a quota error (ms)
# LLM_QUOTA_COOLDOWN_MS=300000
# GROQ_QUOTA_COOLDOWN_MS=2700000
# OPENROUTER_QUOTA_COOLDOWN_MS=2700000
# OPENROUTER_APP_NAME=Mimir
# OPENROUTER_SITE_URL=https://mimirmarkets.xyz
# Jev (TypeSafe AI), optional fast triage model; empty keeps it off.
TYPESAFE_API_KEY=
JEV_MODEL=

# ── Oracle (convex/arcOracle.ts, agents/oracle) ───────────────────────────────
# ORACLE_LLM_THROTTLE_MS=1500
# COINGECKO_API_KEY=
# CMC_API_KEY=                              # a second aggregator reading (CoinGecko and Chainlink are keyless)
# CHAINLINK_RPC_URL=https://ethereum-rpc.publicnode.com
# CHAINLINK_MAX_ROUND_AGE_S=3600
# PRICE_MAX_DEADLINE_SKEW_MS=60000
# PRICE_DEFER_HOURS=6
# SPORTS_SETTLE_GRACE_HOURS=12
# POLYMARKET_READ_RETRY_HOURS=
# ALERT_WEBHOOK_URL=
# MIMIR_PAUSE_ORACLE_SETTLEMENT=1

# ── Council (convex/arcCouncil.ts, agents/council) ────────────────────────────
# COUNCIL_TRACK=                            # classic | philosopher; unset runs both
# COUNCIL_MAX_DECISIONS=12
# COUNCIL_REEVAL_MS=1800000
# COUNCIL_LLM_THROTTLE_MS=4500
# COUNCIL_MAX_CREATOR_MULTIPLE=1
# COUNCIL_RULE_PERSONAS_MAINNET=
# COUNCIL_DRY_RUN=
# MIMIR_PAUSE_COUNCIL=1

# ── House market creator (convex/arcCreator.ts, agents/market-creator) ────────
# MARKET_CREATOR_DRY_RUN=
# MARKET_CREATOR_POLYMARKET=
# MARKET_CREATOR_PREFLIGHT=
# CREATOR_STAKE_USDC=3
# The house creator's daily budget for the markets it opens, mUSD:
# CREATOR_DAILY_BUDGET_USDC=1
# CREATOR_DAILY_MARKETS=2                   # own drafts per day
# CREATOR_HORIZON_MIN=30
# CREATOR_CRYPTO_PER_RUN=2
# CREATOR_SPORTS_PER_RUN=3
# CREATOR_STOCKS_PER_RUN=1
# CREATOR_POLYMARKET_PER_RUN=2
# CREATOR_SPORTS_MAX_HOURS=72
# CREATOR_MIN_QUALITY=60
# CRYPTO_MIN_THRESHOLD_RATIO=0.65
# CRYPTO_MAX_THRESHOLD_RATIO=1.35
# MIMIR_PAUSE_CREATE_MARKET=1

# ── Claim drafts and moderation ───────────────────────────────────────────────
# NEXT_PUBLIC_FEATURE_SOURCE_DRAFTS=1
# CLAIM_DRAFT_MODEL=gemini-3.5-flash
# NEXT_PUBLIC_FEATURE_CLAIM_MODERATION=1
# CLAIM_MODERATION_MODEL=gemini-3.5-flash
# CLAIM_MODERATION_GLOBAL_PER_MIN=120
# CLAIM_DRAFT_GLOBAL_PER_MIN=30
# COUNCIL_PREFLIGHT_GLOBAL_PER_MIN=30

# ── Agent API (BYOA: /api/agents/v1, lib/agents) ──────────────────────────────
# Owners and operators are gno.land accounts (Adena SignArbitrary proofs); writes come back as unsigned gno MsgCalls.
# AGENT_API_IP_PER_MIN=240
# AGENT_API_AGENT_PER_MIN=60

# ── Telegram ──────────────────────────────────────────────────────────────────
# The bot runs on its webhook (scripts/telegram-webhook.mjs set <site>); the backend posts market changes to
# /api/telegram/arc-events (set TELEGRAM_EVENTS_URL=https://<site>/api/telegram/arc-events in Convex).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ADMIN_IDS=
